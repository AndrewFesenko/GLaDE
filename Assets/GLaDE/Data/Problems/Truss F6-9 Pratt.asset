  m_Name: Truss F6-9 Pratt
  m_EditorClassIdentifier: GLaDE.Runtime::GLaDE.Core.StaticsProblem
  problemId: F6-9
  title: "Pratt truss \u2014 forces in KJ, KD and CD"
  category: 0
  sourceReference: Hibbeler, Statics, F6-9
  prompt: 'Determine the force in members <b>KJ</b>, <b>KD</b> and <b>CD</b> of the Pratt truss, and state whether each is in tension or compression.

    Panels are {L} wide and the truss is {h} tall. Loads: P<sub>B</sub> = {P_B}, P<sub>C</sub> = {P_C}, P<sub>D</sub> = {P_D}.'
  thumbnail: {fileID: 0}
  sceneName: Problem_Truss
  kind: 0
  worldScale: 0.12
  parameters:
